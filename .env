# DeepSeek API配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Flask配置
FLASK_SECRET_KEY=your-secret-key-here

# 数据库配置（所有后端脚本统一从这里读取）
# 如果不修改主机/端口/库名，可以只设置密码即可
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=medicalinfo
DB_CHARSET=utf8mb4
DB_PASSWORD=your-db-password-here

# 将your-deepseek-api-key-here和your-db-password-here替换为您的实际密钥/密码
# 获取DeepSeek API密钥请访问：https://platform.deepseek.com/
